# Blockchain
RPC_URL=https://url
WS_URL=wss://url
START_BLOCK=25008849

# Database
DATABASE_URL=postgresql+asyncpg://root:password@postgres:5432/reflow
POSTGRES_USER=root
POSTGRES_PASSWORD=password
POSTGRES_DB=reflow
POSTGRES_PORT=5432

# Redis
REDIS_PASSWORD=password

# JWT signing — generate a long random string for production
JWT_SECRET_KEY=secret
JWT_ALGORITHM=HS256

# SIWE
SIWE_DOMAIN=localhost:3000
SIWE_COOKIE_SECURE=false

# Checker
CHECK_INTERVAL_SECONDS=3600